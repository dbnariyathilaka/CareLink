rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // users/{uid}/profile.* — profile photo. Broadly readable (patients
    // browse caregiver profiles, caregivers see patient profiles); only
    // the owner can upload/replace it. Images only, 5MB cap.
    match /users/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // caregivers/{uid}/... — verification documents (police clearance,
    // training certificates, other qualification docs). Private: owner
    // read/write only — no admin-review flow reads these yet. 15MB cap.
    match /caregivers/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 15 * 1024 * 1024;
    }

    // Everything else is denied by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
