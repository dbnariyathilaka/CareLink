rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // True only for a signed-in account whose OWN users/{uid} doc has
    // role == 'admin' — the same role field the app's own login routing
    // already relies on. Used below to grant the admin dashboard read
    // access across other users' documents, and narrow write access for
    // the one real admin-initiated write this app has (verification
    // document review decisions).
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // users/{uid} — role + basic profile, keyed by Firebase Auth uid.
    // The owner can read/write their own document; admins can additionally
    // read (not write) any user's doc — needed to join real names onto the
    // admin caregivers/patients/bookings/verification-queue/review screens.
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // caregiverProfiles/{uid} — any signed-in user can read (needed for
    // patient search/profile view); only the owner can write their own
    // profile. Admins get one narrow exception: updating only a fixed set
    // of admin-written fields — restricted via affectedKeys() so an admin
    // write can never touch any other field on the profile:
    //   - documentReviews (CaregiverService.setDocumentReviewStatus, the
    //     admin verification-queue screen's real approve/reject decisions)
    //   - referenceCount (CaregiverService.setReferenceCount, written
    //     alongside documentReviews.reference in the same call — a write
    //     touching both top-level fields needs both listed here)
    //   - nicVerified / nicVerifiedAt / nicVerificationReason
    //     (CaregiverService.backfillNicVerification, the one-time
    //     admin-triggered backfill for caregivers who registered before
    //     automatic NIC verification existed)
    //   - hourlyRate / hourlyRateAssignedAt (CaregiverService.setHourlyRate,
    //     both the per-caregiver "Assign" button on the admin profile
    //     screen and the bulk "Apply hourly rates" action on the admin
    //     caregivers list)
    //
    // IMPORTANT: affectedKeys() throws a genuine evaluation error (not just
    // `false`) when the incoming write updates a nested field via a
    // 'documentReviews.$docKey'-style DOTTED STRING KEY in a set(merge:true)
    // call, rather than a real nested Map — this silently denied every
    // admin approve/reject/verify-count/rate-assign write as an unhandled
    // permission-denied crash. set(merge:true) already deep-merges real
    // nested Maps correctly on its own (verified: sibling keys survive), so
    // CaregiverService writes a proper nested Map (e.g.
    // {'documentReviews': {docKey: {...}}}) instead — never a dotted key —
    // which is both simpler and the only form affectedKeys() evaluates
    // cleanly here.
    match /caregiverProfiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'documentReviews', 'referenceCount',
          'nicVerified', 'nicVerifiedAt', 'nicVerificationReason',
          'hourlyRate', 'hourlyRateAssignedAt',
        ]);
    }

    // patientProfiles/{uid} — owner-only for write; any signed-in user can
    // read, same as caregiverProfiles above and for the same reason: a
    // caregiver legitimately needs to read a patient's profile from many
    // real screens (notifications, messages, chat, dashboard, reviews, the
    // dedicated patient-profile screen) the moment there's a booking
    // between them, and rules can't cheaply verify "this caregiver has an
    // active booking with this patient" without a much bigger data-model
    // change — so this mirrors the caregiverProfiles precedent instead of
    // fabricating a narrower check that would just break those screens.
    match /patientProfiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /favorites/{caregiverUid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // familyMembers/{memberId} — also readable by admins: the admin
      // patient-profile screen shows a patient's real care circle.
      match /familyMembers/{memberId} {
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // activity/{activityId} — patient-facing activity feed entries
      // (PatientService.logActivity), e.g. "sent a care request",
      // "member joined the care circle". Owner-only, same as favorites
      // above.
      match /activity/{activityId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // bookingRequests/{bookingId} — created by a patient when they send a
    // care request. Read by any signed-in user, same tradeoff as
    // caregiverProfiles/patientProfiles above: BookingService.
    // currentlyBusyCaregiverIds() (real-time availability, checked on every
    // advanced-match request and on the emergency flow) runs a `whereIn`
    // query across many caregivers' bookings at once, which Firestore can
    // only allow when the rule doesn't depend on resource.data at all — a
    // narrower per-relationship rule would reject that query outright with
    // permission-denied (a live bug this fixes), and there's no backend to
    // compute a smaller availability-only signal instead. Writes stay
    // owner-scoped below; the patientUid on create must match the caller so
    // patients can only create bookings for themselves.
    match /bookingRequests/{bookingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.patientUid;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.patientUid ||
         request.auth.uid == resource.data.caregiverId);
      // Cancelling deletes the live doc after archiving a copy to
      // cancelledBookings — only the owning patient can do this.
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.patientUid;
    }

    // cancelledBookings/{docId} — a reduced, immutable copy written right
    // before a bookingRequests doc is deleted on cancellation, so the
    // patient's "Cancelled" history survives the original being removed.
    // Also readable by admins (same all-bookings streams as above).
    match /cancelledBookings/{docId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.patientUid || isAdmin());
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.patientUid;
    }

    // reviews/{reviewId} — one document per patient review of a caregiver.
    // Any signed-in user can read (shown on the caregiver's public profile,
    // and streamed in full by the admin reviews screen); only the
    // reviewing patient can create their own review, and reviews are
    // immutable afterwards (no update/delete).
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.patientUid;
    }

    // payments/{paymentId} — readable by the patient or caregiver on the
    // payment, or an admin. Billing has no real payment-gateway backend
    // (no Cloud Function/Admin SDK writer exists), so PaymentService.
    // recordCompletedPayment — the sandbox PayHere-style checkout — writes
    // directly from the client, same trust model as `reviews` below: a
    // patient may only create a payment attributed to themselves. This is
    // fine for a sandbox/demo flow with no real money moving, but would
    // need to move to a server-side writer before handling real payments,
    // since nothing here stops a modified client from forging an amount or
    // a 'completed' status. The dispute fields stay update-only, restricted
    // to just what PaymentService.submitDispute actually sets.
    match /payments/{paymentId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.patientUid ||
         request.auth.uid == resource.data.caregiverId ||
         isAdmin());
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.patientUid;
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.patientUid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['disputeReason', 'disputeNote', 'disputeStatus', 'disputeSubmittedAt']);
    }

    // registeredEmails/{email} — minimal, PII-free existence index (doc ID
    // is the lowercased email; the doc body carries nothing but a
    // timestamp) written alongside every users/{uid} write. Lets the
    // unauthenticated forgot-password screen check "is this email
    // registered" without a backend — `allow get` permits checking one
    // already-known email at a time; `list` is not allowed, so the
    // collection can't be bulk-enumerated to harvest every registered
    // address.
    match /registeredEmails/{email} {
      allow get: if true;
      allow write: if request.auth != null;
    }

    // Everything else is denied by default until explicitly added here.
  }
}
